{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(bash Scripts/:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swiftlint:*)",
      "Bash(swiftformat:*)",
      "Bash(xcodegen:*)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//**)",
      "Edit(//**)",
      "Write(//**)"
    ],
    "ask": [
      "Bash(xcodebuild archive:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(xcrun altool:*)",
      "Bash(xcrun notarytool:*)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/.env*)",
      "Write(./**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-swift.sh\"", "timeout": 60 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "echo 'FERNÉ · Claude necesita tu atención.'", "timeout": 5 }
        ]
      }
    ]
  }
}
